{
  "name": "testerai",
  "version": "0.0.1",
  "description": "Generate test cases from Japanese functional spec documents (.docx) into Excel. Local-first, customizable, designed for public-sector SIer workflows.",
  "type": "module",
  "bin": {
    "testerai": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "test-case",
    "test-generation",
    "design-document",
    "japanese",
    "sier",
    "public-sector",
    "ai",
    "claude",
    "anthropic",
    "cli"
  ],
  "author": "Haruya Ura <ft.hu.0418@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "mammoth": "^1.9.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.3",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
